---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/global.css';
import '../styles/graphics.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath, localeIds, localeFromPath, messages, type Locale } from '../i18n';
interface Props { title: string; description: string; active?: string; accent?: string; noindex?: boolean; locale?: Locale; }
const { title, description, active = 'home', accent = 'cyan', noindex = false, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname;
const socialImage = new URL('/social-card.png', Astro.site);
const text = messages(locale);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Johnathan L.', alternateName: 'Johnaverse', jobTitle: 'Site Reliability Engineer', url: Astro.site?.toString(), sameAs: ['https://github.com/Johnaverse', 'https://www.linkedin.com/in/johnathan-l-5b2492146/'] };
---
<!doctype html>
<html lang={locale} data-accent={accent}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111719" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!noindex && localeIds.map(id => <link rel="alternate" hreflang={id === 'zh-Hant' ? 'zh-Hant' : id === 'zh-Hans' ? 'zh-Hans' : id} href={new URL(localizedPath(pagePath, id), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(pagePath, 'en'), Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <noscript><style is:inline>
      @media (max-width: 1000px) {
        .site-header { position: static; }
        .header-inner { flex-wrap: wrap; }
        .menu-toggle { display: none; }
        .primary-nav { display: flex; position: static; width: 100%; flex-wrap: wrap; padding: 12px 0; }
      }
      .motion-toggle { display: none; }
      .map-flow, .map-orbit, .art-glow { animation: none; }
    </style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{text.skip}</a>
    <Header active={active} locale={locale} languageHome={noindex} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
