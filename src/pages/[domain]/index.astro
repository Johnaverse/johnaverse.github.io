---
import DomainPage from '../../components/DomainPage.astro';
import { domains, type Domain } from '../../data/domains';
interface Props { domain: Domain; }
export function getStaticPaths() { return domains.map(domain => ({ params: { domain: domain.id }, props: { domain } })); }
const { domain } = Astro.props;
---
<DomainPage domain={domain} locale="en" />
