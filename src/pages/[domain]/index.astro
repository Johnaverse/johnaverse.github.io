---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemMap from '../../components/SystemMap.astro';
import Artwork from '../../components/Artwork.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import HardwareLab from '../../components/HardwareLab.astro';
import Icon from '../../components/Icon.astro';
import { domains, type Domain } from '../../data/domains';
import { getDomainProjects } from '../../lib/projects';
export function getStaticPaths() { return domains.map(domain => ({ params: { domain: domain.id }, props: { domain } })); }
interface Props { domain: Domain; }
const { domain } = Astro.props;
const projects = await getDomainProjects(domain.id);
---
<BaseLayout title={`${domain.name} — Johnathan L. · Johnaverse`} description={domain.description} active={domain.id} accent={domain.accent}>
  <section class="domain-hero container" id="overview"><div class="domain-hero-copy" data-reveal><a class="back-link" href="/"><span aria-hidden="true">←</span> All domains</a><p class="eyebrow"><span class="status-dot"></span> DOMAIN {domain.index} / {domain.name.toUpperCase()}</p><h1>{domain.headline}</h1><p class="hero-description">{domain.intro}</p><div class="hero-actions"><a class="button button-primary" href="#projects">Explore projects <Icon /></a><a class="button button-quiet" href="#experience">Relevant experience <Icon name="external" size={16} /></a></div></div><div class="domain-hero-visual" data-reveal style="--reveal-delay:100ms"><Artwork subject={domain.id} eager /></div></section>
  <nav class="section-nav" aria-label={`${domain.name} page sections`}><div class="container"><span class="section-nav-label">{domain.name}</span><div><a href="#overview">Overview</a><a href="#capabilities">Capabilities</a><a href="#experience">Experience</a><a href="#projects">Projects</a>{domain.id === 'cloud' && <a href="#lab">Local lab</a>}</div></div></nav>
  <section class="section container" id="capabilities"><div class="section-heading" data-reveal><div><p class="eyebrow">THE ENGINEERING SCOPE</p><h2>What I work on.</h2></div><p>Practical capabilities, grounded in professional work and the projects below.</p></div><div class="capability-layout"><div class="capability-map" data-reveal><SystemMap stages={domain.diagram} label={`${domain.name}: a conceptual engineering view, not a deployment topology.`} /></div><div class="capability-list">{domain.capabilities.map((capability, i) => <article class="capability-item" data-reveal><span class="capability-number">0{i + 1}</span><h3>{capability.title}</h3><div><p>{capability.description}</p><ul class="tag-list">{capability.tools.map(tool => <li>{tool}</li>)}</ul></div></article>)}</div></div>{domain.id === 'cloud' && <a class="text-link capability-extra" href="/cloud/backup/">A closer look at backup, recovery & monitoring <Icon /></a>}</section>
  <section class="experience-section section" id="experience"><div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">PROFESSIONAL EXPERIENCE</p><h2>The work behind<br />the knowledge.</h2></div><p>The parts of my career most relevant to {domain.name.toLowerCase()}, from infrastructure operations to software engineering.</p></div><ExperienceList domain={domain.id} /></div></section>
  <section class="section container" id="projects"><div class="section-heading" data-reveal><div><p class="eyebrow">APPLIED ENGINEERING</p><h2>Projects & systems.</h2></div><p>Public repositories and focused overviews of my work. Explore the purpose, implementation, and contribution behind each project.</p></div><div class="project-grid">{projects.map((project, i) => <ProjectCard project={project} index={i} />)}</div></section>
  {domain.id === 'cloud' && <HardwareLab />}
  <section class="next-domain container"><span class="eyebrow">CONTINUE EXPLORING</span><div>{domains.filter(item => item.id !== domain.id).map(item => <a href={`/${item.id}/`}>{item.name}<Icon name="external" /></a>)}</div></section>
</BaseLayout>
