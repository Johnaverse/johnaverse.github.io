---
import { getPublishedProjects } from '../../../lib/projects';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
export async function getStaticPaths() { return (await getPublishedProjects()).map(project => ({ params: { domain: project.data.primaryDomain, slug: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<ProjectDetail project={project} locale="en" />
