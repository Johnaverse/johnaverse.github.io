---
// A fullscreen, no-scroll entrance to the Cybersecurity domain: left-locked type over a graded looping video.
import sgUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jbUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { domains } from '../data/domains';
import { getDomainProjects } from '../lib/projects';

const domain = domains.find(item => item.id === 'cybersecurity')!;
const projectCount = (await getDomainProjects('cybersecurity')).length;
const title = `${domain.name} — Johnathan L. · Johnaverse`;
const description = domain.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-card.png', Astro.site);
const video = 'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260809_132544_b6ef0174-ed95-45ad-9a2f-ccb8acfbdce8.mp4';
const fontFaces = `@font-face{font-family:'SG';src:url(${sgUrl}) format('woff2');font-weight:300 700;font-style:normal;font-display:block}@font-face{font-family:'JB';src:url(${jbUrl}) format('woff2');font-weight:100 800;font-style:normal;font-display:block}`;
const domainLinks = [
  { label: 'Cloud', href: '/cloud/' },
  { label: 'AI', href: '/ai/' },
  { label: 'Blockchain', href: '/blockchain/' },
  { label: 'Cybersecurity', href: '/cybersecurity/' },
];
const sectionLinks = [
  { label: 'Capabilities', href: '/cybersecurity/#capabilities' },
  { label: 'Experience', href: '/cybersecurity/#experience' },
  { label: 'Projects', href: '/cybersecurity/#projects' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={socialImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImage}>
<link rel="preload" href={sgUrl} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={jbUrl} as="font" type="font/woff2" crossorigin>
<style set:html={fontFaces}></style>
<script is:inline>
  // Arm the entrance before first paint, unless motion is off; never leave content hidden.
  (function () {
    var d = document.documentElement, paused = false;
    try { paused = localStorage.getItem('johnaverse-motion') === 'paused'; } catch (e) { /* storage may be unavailable */ }
    if (!paused && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in d) {
      d.classList.add('intro');
      setTimeout(function () { d.classList.remove('intro'); }, 4000);
    }
  })();
</script>
<noscript><style>
  @media (max-width: 1023px) {
    .burger { display: none !important; }
    .nav { display: flex !important; left: calc(var(--bx) * var(--s)); top: calc((var(--by) + var(--bs) + 8) * var(--s)); height: auto; font-size: calc(15 * var(--s)); }
  }
</style></noscript>
</head>
<body>
