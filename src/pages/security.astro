</svg>

<div class="screen" id="stage">
  <div class="bg" aria-hidden="true"><video src={video} autoplay muted loop playsinline preload="auto" tabindex="-1"></video></div>
  <div class="bg2" aria-hidden="true"><video src={video} autoplay muted loop playsinline preload="auto" tabindex="-1"></video></div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="frame">
    <header class="top">
      <a class="logo" href="/" aria-label="Johnaverse home">
        <svg viewBox="10 10 48 48" aria-hidden="true"><path d="M16 18h10v21q0 8-9 8m20-29 7 29 8-29" fill="none" stroke="#fff" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="18" cy="47" r="3.6" fill="#c81b1c"></circle></svg>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="/">Home</a>
        <details class="dd">
          <summary>Domains <svg class="chev" viewBox="0 0 11 6" aria-hidden="true"><path d="M1 1L5.5 5L10 1" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></summary>
          <div class="dd-panel">{domainLinks.map(link => <a href={link.href}>{link.label}</a>)}</div>
        </details>
        <details class="dd">
          <summary>Security <svg class="chev" viewBox="0 0 11 6" aria-hidden="true"><path d="M1 1L5.5 5L10 1" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></summary>
          <div class="dd-panel">{sectionLinks.map(link => <a href={link.href}>{link.label}</a>)}</div>
        </details>
        <a href="/#contact">Contact</a>
      </nav>
      <a class="btn btn-top" href="/#contact"><span>Let’s connect</span><svg viewBox="0 0 21.5 18" aria-hidden="true"><path d="M0 9H20.1M12.1 1L20.1 9L12.1 17" fill="none" stroke="#fff" stroke-width="2"></path></svg></a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    </header>

    <main class="main">
      <div class="sp sp-a"></div>
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">
          <span class="ln"><span>Security analysis</span></span>
          <span class="ln"><span>from source code</span></span>
          <span class="ln"><span>to attack surface.</span></span>
        </h1>
        <p class="sub">I combine source analysis with a view of the wider system:<br class="br"> the service, its dependencies, and its trust boundaries.</p>
        <a class="btn btn-cta" href="/cybersecurity/#projects"><span>View projects</span><svg viewBox="0 0 21.5 18" aria-hidden="true"><path d="M0 9H20.1M12.1 1L20.1 9L12.1 17" fill="none" stroke="#fff" stroke-width="2"></path></svg></a>
      </section>
      <div class="sp sp-b"></div>
      <section class="stats" aria-label="At a glance">
        <ul>
          <li class="s1"><span class="num">{projectCount}</span><span class="lab">Projects</span></li>
          <li class="s2"><span class="num">2019</span><span class="lab">BSc InfoSec</span></li>
          <li class="s3"><span class="num">2021–23</span><span class="lab">Security analyst</span></li>
        </ul>
        <i class="rule r1" aria-hidden="true"></i><i class="rule r2" aria-hidden="true"></i>
      </section>
      <div class="sp sp-c"></div>
    </main>
  </div>

  <div class="menu" id="menu" aria-label="Menu">
    <div class="menu-tex" aria-hidden="true"><video src={video} autoplay muted loop playsinline preload="auto" tabindex="-1"></video></div>
    <i class="menu-rule" aria-hidden="true"></i>
    <div class="menu-body">
      <p class="menu-eyebrow">Menu</p>
      <ul class="mlist">
        <li><a class="mrow" href="/">Home</a></li>
        <li>
          <button class="mrow" type="button" aria-expanded="false" aria-controls="m-domains">Domains <svg class="chev" viewBox="0 0 11 6" aria-hidden="true"><path d="M1 1L5.5 5L10 1" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></button>
          <div class="msub" id="m-domains" hidden>{domainLinks.map(link => <a href={link.href}>{link.label}</a>)}</div>
        </li>
        <li>
          <button class="mrow" type="button" aria-expanded="false" aria-controls="m-security">Security <svg class="chev" viewBox="0 0 11 6" aria-hidden="true"><path d="M1 1L5.5 5L10 1" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></button>
          <div class="msub" id="m-security" hidden>{sectionLinks.map(link => <a href={link.href}>{link.label}</a>)}</div>
        </li>
        <li><a class="mrow" href="/#contact">Contact</a></li>
      </ul>
      <div class="menu-foot">
        <a class="btn btn-menu" href="/#contact"><span>Let’s connect</span><svg viewBox="0 0 21.5 18" aria-hidden="true"><path d="M0 9H20.1M12.1 1L20.1 9L12.1 17" fill="none" stroke="#fff" stroke-width="2"></path></svg></a>
        <p class="menu-note">Site reliability engineer &nbsp;/&nbsp; Toronto, Canada</p>
      </div>
    </div>
  </div>
</div>
<i class="probe" aria-hidden="true"></i>

<style is:global>
  /* Canvas scaler: every layout value is N × --s on a 1505×700 (desktop), 900×1200 (tablet portrait) or 430×620 (phone) canvas. */
  :root {
    --s: min(100vw / 1505, 100vh / 700);
    --red: #c81b1c; --ink: #fff; --sub: #e6e6e6; --lab: #949494;
    --bx: 60; --by: 36; --bs: 44;
    --left: 73;
    --h1y: -12.5; --h1fs: 68.7; --h1lh: 76; --h1ls: -2.4;
    --subfs: 18.7; --sublh: 26; --subls: -.87; --subgap: 28;
    --ctagap: 28.5;
    --numy: 19; --laby: 74; --numfs: 33.45; --labfs: 21.9; --statsh: 104;
    --st1: 70.4; --st2: 213.1; --st3: 392.6; --r1: 181; --r2: 356;
    --logo: 45; --logox: 60; --logoy: 35;
    --btnw: 212; --btnh: 58; --btnpl: 18; --btnpr: 22; --btngap: 11; --btnfs: 20.85;
    --spa: 239; --spb: 194; --spc: 115;
    --EXPO: cubic-bezier(.16, 1, .3, 1);
  }
  @media (max-width: 1023px) and (max-aspect-ratio: 1/1) {
    :root {
      --s: clamp(0.82px, min(100vw / 900, 100vh / 1200), 1.25px);
      --bx: 56; --by: 33; --bs: 40;
      --left: 60;
      --h1y: -10.25; --h1fs: 56.3; --h1lh: 62.3; --h1ls: -1.97;
      --subfs: 15.3; --sublh: 21.3; --subls: -.71; --subgap: 23;
      --ctagap: 23.4;
      --numy: 15.6; --laby: 60.7; --numfs: 27.4; --labfs: 18; --statsh: 86;
      --st1: 57.7; --st2: 174.7; --st3: 321.9; --r1: 148.4; --r2: 291.9;
      --logo: 37; --logox: 56; --logoy: 34;
      --btnw: 174; --btnh: 47.6; --btnpl: 14.8; --btnpr: 18; --btngap: 9; --btnfs: 17.1;
      --spa: 340; --spb: 276; --spc: 163;
    }
  }
  @media (max-width: 599px) {
    :root {
      --s: min(100vw / 430, 100vh / 620, 1.02px);
      --bx: 26; --by: 21; --bs: 34;
      --left: 26;
      --h1y: -7.1; --h1fs: 39; --h1lh: 43.2; --h1ls: -1.36;
      --subfs: 13; --sublh: 19; --subls: -.5; --subgap: 21;
      --ctagap: 22;
      --numy: 13; --laby: 50; --numfs: 22.7; --labfs: 14.9; --statsh: 72;
      --st1: 26; --st2: 123; --st3: 245; --r1: 101; --r2: 220;
      --logo: 34; --logox: 26; --logoy: 21;
      --btnw: 185; --btnh: 50; --btnpl: 15.7; --btnpr: 19.1; --btngap: 9.6; --btnfs: 17.5;
      --spa: 106; --spb: 92; --spc: 56;
    }
  }

  html, body { height: 100%; margin: 0; background: #000; overflow: hidden; }
  body { color: var(--ink); -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision; font-family: 'JB', ui-monospace, monospace; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .svgdefs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .probe { position: absolute; width: calc(100 * var(--s)); height: 0; visibility: hidden; pointer-events: none; }

  /* Stage and video plates */
  .screen { position: fixed; inset: 0; overflow: hidden; background: #000; }
  .bg, .bg2 { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .bg { filter: url(#grade); }
  .bg video, .bg2 video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .bg2 { filter: url(#grade2); mix-blend-mode: plus-lighter; opacity: .35; -webkit-mask-image: linear-gradient(180deg, transparent 21.5%, #000 100%); mask-image: linear-gradient(180deg, transparent 21.5%, #000 100%); }
  .scrim { position: absolute; inset: 0; pointer-events: none; display: none; }

  /* Frame */
  .frame { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .main { display: contents; }
  .sp { flex: 1 1 0; min-height: 0; }
  .sp-a { flex-grow: var(--spa); } .sp-b { flex-grow: var(--spb); } .sp-c { flex-grow: var(--spc); }

  /* Header */
  .top { position: relative; flex: none; height: calc(90 * var(--s)); z-index: 60; }
  .logo { position: absolute; left: calc(var(--logox) * var(--s)); top: calc(var(--logoy) * var(--s)); width: calc(var(--logo) * var(--s)); height: calc(var(--logo) * var(--s)); }
  .logo svg { width: 100%; height: 100%; display: block; }
  .nav { position: absolute; left: calc(482 * var(--s)); top: calc(32 * var(--s)); height: calc(58 * var(--s)); display: flex; align-items: center; font: 400 calc(19.9 * var(--s)) / 1 'JB', ui-monospace, monospace; }
  .nav > :nth-child(2) { margin-left: calc(53 * var(--s)); }
  .nav > :nth-child(3) { margin-left: calc(40 * var(--s)); }
  .nav > :nth-child(4) { margin-left: calc(37 * var(--s)); }
  .nav a, .dd summary { display: inline-flex; align-items: center; gap: calc(7 * var(--s)); height: calc(58 * var(--s)); color: #fff; transition: color .15s; }
  .dd { position: relative; }
  .dd summary { list-style: none; cursor: pointer; }
  .dd summary::-webkit-details-marker { display: none; }
  .chev { width: calc(11.6 * var(--s)); height: calc(7.2 * var(--s)); margin-top: calc(-2.6 * var(--s)); flex: none; }
  .dd[open] .chev { transform: rotate(180deg); }
  .dd-panel { position: absolute; left: calc(-14 * var(--s)); top: calc(54 * var(--s)); min-width: calc(220 * var(--s)); padding: calc(8 * var(--s)) 0; background: #000; border: 1px solid rgba(255, 255, 255, .14); }
  .dd-panel a { display: flex; height: calc(40 * var(--s)); padding: 0 calc(14 * var(--s)); font-size: calc(16 * var(--s)); color: var(--sub); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; justify-content: space-between; gap: calc(var(--btngap) * var(--s)); min-width: calc(var(--btnw) * var(--s)); height: calc(var(--btnh) * var(--s)); padding: 0 calc(var(--btnpr) * var(--s)) 0 calc(var(--btnpl) * var(--s)); background: var(--red); color: #fff; border-radius: 0; box-sizing: border-box; white-space: nowrap; transition: background-color .15s; }
  .btn span { font: 480 calc(var(--btnfs) * var(--s)) / 1 'SG', system-ui, sans-serif; letter-spacing: calc(-.62 * var(--s)); transform: translateY(calc(1.5 * var(--s))); }
  .btn svg { width: calc(21.5 * var(--s) * var(--btnfs) / 20.85); height: calc(18 * var(--s) * var(--btnfs) / 20.85); flex: none; transition: transform .15s; }
  .btn-top { position: absolute; right: calc(61 * var(--s)); top: calc(30 * var(--s)); }

  /* Burger */
  .burger { display: none; position: absolute; right: calc(var(--bx) * var(--s)); top: calc(var(--by) * var(--s)); width: calc(var(--bs) * var(--s)); height: calc(var(--bs) * var(--s)); flex-direction: column; justify-content: center; align-items: flex-end; gap: calc(var(--bs) * .16 * var(--s)); }
  .burger span { display: block; width: 100%; height: 2px; background: #fff; transition: transform .3s var(--EXPO), opacity .2s, width .3s var(--EXPO); }
  .burger span:nth-child(3) { width: 47%; }
  body.nav-open .burger span { width: 100%; }
  body.nav-open .burger span:nth-child(1) { transform: translateY(calc(var(--bs) * .16 * var(--s) + 2px)) rotate(45deg); }
  body.nav-open .burger span:nth-child(2) { opacity: 0; }
  body.nav-open .burger span:nth-child(3) { transform: translateY(calc(var(--bs) * -.16 * var(--s) - 2px)) rotate(-45deg); }

  /* Hero */
  .hero { flex: none; padding-left: calc(var(--left) * var(--s)); position: relative; z-index: 2; }
  .hero h1 { margin: calc(var(--h1y) * var(--s)) 0 0; font: 700 calc(var(--h1fs) * var(--s)) / calc(var(--h1lh) * var(--s)) 'SG', system-ui, sans-serif; letter-spacing: calc(var(--h1ls) * var(--s)); }
  .ln { display: block; }
  .ln > span { display: inline-block; }
  .sub { margin: calc(var(--subgap) * var(--s)) 0 0; max-width: calc(640 * var(--s)); font: 400 calc(var(--subfs) * var(--s)) / calc(var(--sublh) * var(--s)) 'JB', ui-monospace, monospace; letter-spacing: calc(var(--subls) * var(--s)); color: var(--sub); }
  .btn-cta { margin-top: calc(var(--ctagap) * var(--s)); }

  /* Stats */
  .stats { flex: none; position: relative; height: calc(var(--statsh) * var(--s)); z-index: 2; }
  .stats ul { margin: 0; padding: 0; list-style: none; }
  .stats li { position: absolute; top: 0; }
  .s1 { left: calc(var(--st1) * var(--s)); } .s2 { left: calc(var(--st2) * var(--s)); } .s3 { left: calc(var(--st3) * var(--s)); }
  .num { position: absolute; top: calc(var(--numy) * var(--s)); white-space: nowrap; font: 480 calc(var(--numfs) * var(--s)) / 1 'JB', ui-monospace, monospace; color: #fff; }
  .s3 .num { margin-left: calc(-4.4 * var(--s)); }
  .lab { position: absolute; top: calc(var(--laby) * var(--s)); white-space: nowrap; font: 400 calc(var(--labfs) * var(--s)) / 1 'SG', system-ui, sans-serif; letter-spacing: calc(-.62 * var(--s)); color: var(--lab); }
  .rule { position: absolute; top: calc(8 * var(--s)); height: calc((var(--statsh) - 8) * var(--s)); width: calc(1.5 * var(--s)); background: linear-gradient(180deg, rgba(255, 255, 255, .085), rgba(255, 255, 255, .21) 50%, rgba(255, 255, 255, .085)); }
  .r1 { left: calc(var(--r1) * var(--s)); } .r2 { left: calc(var(--r2) * var(--s)); }

  /* Mobile menu */
  .menu { position: absolute; inset: 0; z-index: 50; background: #000; visibility: hidden; opacity: 0; transition: opacity .3s, visibility 0s .3s; }
  body.nav-open .menu { visibility: visible; opacity: 1; transition: opacity .3s; }
  .menu-tex { position: absolute; inset: 0; opacity: .4; pointer-events: none; filter: url(#grade2); -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 55%); mask-image: linear-gradient(180deg, transparent 0%, #000 55%); }
  .menu-tex video { width: 100%; height: 100%; object-fit: cover; object-position: 78% top; display: block; }
  .menu-rule { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--red); transform: scaleX(0); transform-origin: left; }
  body.nav-open .menu-rule { transform: scaleX(1); transition: transform .55s cubic-bezier(.2, .7, .2, 1) .04s; }
  .menu-body { position: relative; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; padding: calc((var(--by) + var(--bs) + 40) * var(--s)) calc(var(--bx) * var(--s)) calc(32 * var(--s)); }
  .menu-eyebrow { margin: 0 0 calc(14 * var(--s)); font: 400 calc(11.5 * var(--s)) / 1 'JB', ui-monospace, monospace; letter-spacing: .22em; text-transform: uppercase; color: var(--lab); }
  .mlist { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255, 255, 255, .12); }
  .mlist > li { border-bottom: 1px solid rgba(255, 255, 255, .12); }
  .mrow { display: flex; width: 100%; align-items: center; justify-content: space-between; min-height: calc(64 * var(--s)); font: 700 calc(30 * var(--s)) / 1 'SG', system-ui, sans-serif; letter-spacing: calc(-.9 * var(--s)); color: #fff; text-align: left; transition: color .15s; }
  .mrow .chev { width: calc(14 * var(--s)); height: calc(8 * var(--s)); transition: transform .25s; }
  .mrow[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .msub { display: flex; flex-direction: column; padding: 0 0 calc(14 * var(--s)); }
  .msub[hidden] { display: none; }
  .msub a { display: flex; align-items: center; min-height: calc(40 * var(--s)); font: 400 calc(15 * var(--s)) / 1.3 'JB', ui-monospace, monospace; color: var(--sub); transition: color .15s; }
  .menu-foot { margin-top: auto; display: flex; flex-direction: column; gap: calc(14 * var(--s)); }
  .btn-menu { width: 100%; }
  .menu-note { margin: 0; font: 400 calc(12 * var(--s)) / 1.4 'JB', ui-monospace, monospace; color: var(--lab); }
  body.nav-open .mlist > li, body.nav-open .menu-foot { animation: mrise .5s cubic-bezier(.22, 1, .36, 1) both; }
  body.nav-open .mlist > li:nth-child(1) { animation-delay: .08s; }
  body.nav-open .mlist > li:nth-child(2) { animation-delay: .14s; }
  body.nav-open .mlist > li:nth-child(3) { animation-delay: .20s; }
  body.nav-open .mlist > li:nth-child(4) { animation-delay: .26s; }
  body.nav-open .menu-foot { animation-delay: .32s; }
  @keyframes mrise { from { opacity: 0; transform: translateY(calc(10 * var(--s))); } }

  @media (hover: hover) {
    .nav a:hover, .dd summary:hover, .dd-panel a:hover { color: var(--red); }
    .btn:hover { background: #b01617; }
    .btn:hover svg { transform: translateX(calc(3 * var(--s))); }
    .mrow:hover, .msub a:hover { color: var(--red); }
  }

  /* Tablet and phone: burger instead of the bar */
  @media (max-width: 1023px) {
    .nav, .btn-top { display: none; }
    .burger { display: flex; }
    .top { height: calc((var(--by) * 2 + var(--bs)) * var(--s)); }
    .br { display: none; }
  }
  @media (min-width: 1024px) { .menu { display: none; } }
  @media (max-width: 1023px) and (max-aspect-ratio: 1/1) {
    .bg2 { display: none; }
    .bg video { object-position: right top; transform: scale(1.18); transform-origin: right top; }
    .bg { -webkit-mask-image: linear-gradient(180deg, #000 0 40%, transparent 64%); mask-image: linear-gradient(180deg, #000 0 40%, transparent 64%); }
    .scrim { display: block; background: linear-gradient(100deg, #000 26%, rgba(0, 0, 0, .74) 50%, rgba(0, 0, 0, .18) 76%, transparent 92%); }
  }
  @media (max-width: 599px) {
    .bg video, .bg2 video { object-position: 78% top; transform: none; }
    .bg { -webkit-mask-image: none; mask-image: none; }
    .bg2 { display: block; -webkit-mask-image: linear-gradient(180deg, transparent 10%, #000 60%); mask-image: linear-gradient(180deg, transparent 10%, #000 60%); }
    .scrim { display: block; background: linear-gradient(180deg, rgba(0, 0, 0, .10) 0%, rgba(0, 0, 0, .50) 24%, rgba(0, 0, 0, .86) 42%, #000 66%); }
  }

  /* Entrance: initial state, armed in <head> only when motion is allowed */
  html.intro .logo { opacity: 0; transform: scale(.9); }
  html.intro .nav > * { opacity: 0; transform: translateY(calc(7 * var(--s))); }
  html.intro .burger { opacity: 0; }
  html.intro .btn-top, html.intro .btn-cta { clip-path: inset(0 100% 0 0); }
  html.intro .ln { overflow: hidden; padding-bottom: calc(6 * var(--s)); margin-bottom: calc(-6 * var(--s)); }
  html.intro .ln > span { transform: translateY(120%); }
  html.intro .sub { opacity: 0; transform: translateY(calc(14 * var(--s))); }
  html.intro .rule { transform: scaleY(0); transform-origin: center; }
  html.intro .num { opacity: 0; transform: translateY(calc(12 * var(--s))); }
  html.intro .lab { opacity: 0; transform: translateY(calc(10 * var(--s))); }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>

<script>
  const html = document.documentElement;
  const body = document.body;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let paused = false;
  try { paused = localStorage.getItem('johnaverse-motion') === 'paused'; } catch { /* storage may be unavailable */ }

  // Video: keep the three plates in step with the first; stop them when motion is off.
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.screen video')];
  if (reduce || paused) {
    for (const v of videos) { v.removeAttribute('autoplay'); v.pause(); }
  } else {
    const master = videos[0];
    master?.addEventListener('timeupdate', () => {
      for (const v of videos.slice(1)) if (Math.abs(v.currentTime - master.currentTime) > 0.12) v.currentTime = master.currentTime;
    });
  }

  // Desktop dropdowns: one open at a time; Escape or an outside click closes them.
  const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>('.dd')];
  for (const dd of dropdowns) dd.addEventListener('toggle', () => { if (dd.open) for (const other of dropdowns) if (other !== dd) other.open = false; });
  document.addEventListener('click', e => { if (!(e.target as Element).closest('.dd')) for (const dd of dropdowns) dd.open = false; });

  // Mobile menu
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const menu = document.getElementById('menu')!;
  const frame = document.querySelector<HTMLElement>('.frame .main')!;
  const rows = [...menu.querySelectorAll<HTMLButtonElement>('button.mrow')];
  const setAccordion = (open: HTMLButtonElement | null) => {
    for (const row of rows) {
      const expanded = row === open && row.getAttribute('aria-expanded') !== 'true';
      row.setAttribute('aria-expanded', String(expanded));
      document.getElementById(row.getAttribute('aria-controls')!)!.hidden = !expanded;
    }
  };
  const setMenu = (open: boolean) => {
    body.classList.toggle('nav-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    frame.inert = open;
    if (open) menu.querySelector<HTMLElement>('.mrow')?.focus();
    else setAccordion(null);
  };
  burger.addEventListener('click', () => setMenu(!body.classList.contains('nav-open')));
  for (const row of rows) row.addEventListener('click', () => setAccordion(row));
  for (const link of menu.querySelectorAll('a')) link.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    for (const dd of dropdowns) dd.open = false;
    if (body.classList.contains('nav-open')) { setMenu(false); burger.focus(); }
  });
  addEventListener('resize', () => { if (innerWidth >= 1024 && body.classList.contains('nav-open')) setMenu(false); });

  // Entrance choreography: one shot, absolute timeline in seconds.
  if (html.classList.contains('intro')) {
    const EXPO = 'cubic-bezier(.16,1,.3,1)', QUINT = 'cubic-bezier(.22,1,.36,1)', QUART = 'cubic-bezier(.25,1,.5,1)', TYPE = 'cubic-bezier(.22,.85,.24,1)';
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      const k = matchMedia('(max-width: 599px)').matches ? 0.86 : 1;
      const s = (document.querySelector<HTMLElement>('.probe')!.getBoundingClientRect().width || 100) / 100;
      const all: Animation[] = [];
      const play = (els: Element[], frames: Keyframe[], at: number, dur: number, easing: string, stagger = 0) =>
        els.forEach((el, i) => all.push(el.animate(frames, { delay: (at + i * stagger) * 1000 * k, duration: dur * 1000 * k, easing, fill: 'both' })));
      const q = (sel: string) => [...document.querySelectorAll(sel)];
      const rise = (px: number): Keyframe[] => [{ opacity: 0, transform: `translateY(${px * s}px)` }, { opacity: 1, transform: 'none' }];
      const wipe: Keyframe[] = [{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)' }];
      play(q('.logo'), [{ opacity: 0, transform: 'scale(.9)' }, { opacity: 1, transform: 'none' }], 0, 0.70, EXPO);
      play(q('.nav > *'), rise(7), 0.12, 0.62, QUINT, 0.055);
      play(q('.burger'), [{ opacity: 0 }, { opacity: 1 }], 0.18, 0.55, QUART);
      play(q('.btn-top'), wipe, 0.28, 0.66, EXPO);
      play(q('.ln > span'), [{ transform: 'translateY(120%)' }, { transform: 'none' }], 0.34, 0.98, TYPE, 0.09);
      play(q('.sub'), rise(14), 0.74, 0.72, QUINT);
      play(q('.btn-cta'), wipe, 0.90, 0.70, EXPO);
      play(q('.rule'), [{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], 0.98, 0.60, QUART, 0.07);
      play(q('.num'), rise(12), 1.04, 0.66, QUINT, 0.085);
      play(q('.lab'), rise(10), 1.10, 0.62, QUINT, 0.085);
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        html.classList.remove('intro');
        for (const a of all) a.cancel();
      };
      Promise.all(all.map(a => a.finished)).then(finish, finish);
      setTimeout(finish, 4000);
    };
    const kick = () => { requestAnimationFrame(start); setTimeout(start, 1200); };
    Promise.race([document.fonts.ready, new Promise(r => setTimeout(r, 1000))]).then(kick);
  }
</script>
</body>
</html>
