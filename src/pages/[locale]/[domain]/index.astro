---
import DomainPage from '../../../components/DomainPage.astro';
import { domains, type Domain } from '../../../data/domains';
import { localeIds, isPrefixedLocale, localizedDomain, type Locale } from '../../../i18n';
export function getStaticPaths() { return localeIds.filter(isPrefixedLocale).flatMap(locale => domains.map(domain => ({ params: { locale, domain: domain.id }, props: { domain: localizedDomain(domain, locale), locale } }))); }
interface Props { domain: Domain; locale: Locale; }
const { domain, locale } = Astro.props;
---
<DomainPage domain={domain} locale={locale} />
