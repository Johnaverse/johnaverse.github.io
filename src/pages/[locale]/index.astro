---
import HomePage from '../../components/HomePage.astro';
import { localeIds, isPrefixedLocale, type Locale } from '../../i18n';
export function getStaticPaths() { return localeIds.filter(isPrefixedLocale).map(locale => ({ params: { locale }, props: { locale } })); }
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<HomePage locale={locale} />
