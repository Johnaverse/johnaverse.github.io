---
// Document metadata shared by every page: canonical and alternate URLs, social cards and structured data.
import { localizedPath, localeIds, type Locale } from '../i18n';
interface Props { title: string; description: string; locale: Locale; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname;
const socialImage = new URL('/social-card.png', Astro.site);
const person = { '@context': 'https://schema.org', '@type': 'Person', name: 'Johnathan L.', alternateName: 'Johnaverse', jobTitle: 'Site Reliability Engineer', url: Astro.site?.toString(), sameAs: ['https://github.com/Johnaverse', 'https://www.linkedin.com/in/johnathan-l-5b2492146/'] };
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#111719" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
{!noindex && localeIds.map(id => <link rel="alternate" hreflang={id === 'zh-Hant' ? 'zh-Hant' : id === 'zh-Hans' ? 'zh-Hans' : id} href={new URL(localizedPath(pagePath, id), Astro.site)} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(pagePath, 'en'), Astro.site)} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
