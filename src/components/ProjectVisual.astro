---
import type { CollectionEntry } from 'astro:content';
import { messages, type Locale } from '../i18n';
import { localizedWorkflowStages } from '../i18n/projects';

interface Props { project: CollectionEntry<'projects'>; locale?: Locale; title?: string; }
interface Stage { label: string; icon: keyof typeof icons; }
interface Diagram { stages: Stage[]; edges?: [number, number][]; }

const icons = {
  sources: ['M8 8h8v8H8z M28 8h8v8h-8z M18 28h8v8h-8z', 'M12 16v5h20v-5 M22 21v7'],
  registry: ['M9 7h26v30H9z', 'M15 15h14 M15 22h14 M15 29h9'],
  api: ['M14 12 5 22l9 10 M30 12l9 10-9 10 M25 8l-6 28'],
  logs: ['M8 6h28v32H8z', 'M14 14h16 M14 21h12 M14 28h16'],
  threshold: ['M6 12h32 M6 22h32 M6 32h32', 'M14 8v8 M30 18v8 M19 28v8'],
  restart: ['M35 17a14 14 0 1 0 1 12', 'M35 7v10H25', 'M22 14v8l6 4'],
  metrics: ['M7 7v30h30', 'M11 28l8-10 8 5 10-14'],
  request: ['M7 8h30v22H19l-8 7v-7H7z', 'M13 16h18 M13 22h11'],
  node: ['M9 7h26v12H9z M9 25h26v12H9z', 'M15 13h1 M21 13h8 M15 31h1 M21 31h8 M22 19v6'],
  response: ['M9 6h20l7 7v25H9z', 'M29 6v8h7 M15 24l5 5 10-11'],
  charts: ['M8 8h12v12H8z M24 8h12v12H24z M8 24h12v12H8z M24 24h12v12H24z'],
  cluster: ['M22 5l8 5v9l-8 5-8-5v-9z M9 25l8 5v9l-8 5-8-5v-9z M35 25l8 5v9l-8 5-8-5v-9z', 'M17 21l-4 5 M27 21l4 5'],
  service: ['M22 5 38 14v17l-16 9L6 31V14z', 'M6 14l16 9 16-9 M22 23v17'],
  terraform: ['M6 7l13 7v14L6 21z M23 16l13 7v14l-13-7z M23 2l13 7v10l-13-7z'],
  plan: ['M10 7h25v30H10z', 'M15 14h14 M15 22l3 3 5-6 M25 23h4 M15 31h14'],
  cloud: ['M12 33h22a8 8 0 0 0 1-16 13 13 0 0 0-25-2A9 9 0 0 0 12 33Z'],
  access: ['M11 19h22v19H11z', 'M16 19v-7a6 6 0 0 1 12 0v7 M22 27v5'],
  git: ['M12 10v22a7 7 0 0 0 14 0V18 M26 18a7 7 0 0 1 7-7', 'M8 6h8v8H8z M8 28h8v8H8z M29 7h8v8h-8z'],
  flux: ['M32 9a15 15 0 0 0-24 9 M12 35a15 15 0 0 0 24-9', 'M8 8v10h10 M36 36V26H26'],
  docker: ['M8 15h8v8H8z M18 15h8v8h-8z M28 15h8v8h-8z M18 5h8v8h-8z', 'M4 27h34c-2 8-9 12-18 12S6 35 4 27Z'],
  tool: ['M29 7a10 10 0 0 0-13 13L6 30l8 8 10-10A10 10 0 0 0 37 15l-7 7-8-8z'],
  routing: ['M6 22h12 M26 10h12 M26 34h12 M18 22l8-12 M18 22l8 12', 'M16 19h6v6h-6z'],
  models: ['M22 4l7 4v8l-7 4-7-4V8z M9 25l7 4v8l-7 4-7-4v-8z M35 25l7 4v8l-7 4-7-4v-8z', 'M17 19l-4 7 M27 19l4 7'],
  shield: ['M22 4 36 10v12c0 9-7 15-14 19C15 37 8 31 8 22V10z', 'M15 22l5 5 10-11'],
  review: ['M19 7a12 12 0 1 0 0 24 12 12 0 0 0 0-24Z M28 28l10 10', 'M13 19l4 4 8-9'],
  qa: ['M9 6h26v32H9z', 'M14 15l3 3 5-6 M26 15h4 M14 28l3 3 5-6 M26 28h4'],
  feedback: ['M8 8h28v21H21l-9 8v-8H8z', 'M15 15h14 M15 22h9'],
  signal: ['M4 23h7l5-13 8 25 6-18 5 6h5'],
  triage: ['M6 8h32L26 23v13l-8-5v-8z'],
  code: ['M15 11 5 22l10 11 M29 11l10 11-10 11 M25 7l-6 30'],
  analysis: ['M8 8h20v28H8z M31 14h5v22h-5', 'M13 15h10 M13 22h10 M13 29h6'],
  findings: ['M22 4 40 37H4z', 'M22 16v10 M22 31h.1'],
  stream: ['M4 10h12l8 12h16 M4 22h12 M4 34h12l8-12', 'M34 16l6 6-6 6'],
  contract: ['M9 5h19l8 8v26H9z M28 5v9h8', 'M15 21h14 M15 28h14 M15 34h8'],
  deploy: ['M22 32V8 M13 17l9-9 9 9', 'M9 28v10h26V28'],
  backup: ['M8 11c0-4 28-4 28 0s-28 4-28 0Z M8 11v23c0 4 28 4 28 0V11', 'M8 22c0 4 28 4 28 0'],
  update: ['M10 31a15 15 0 1 0-2-17 M22 30V13 M15 20l7-7 7 7', 'M8 5v9h9'],
} as const;

const diagrams: Record<string, Diagram> = {
  'chains-api': { stages: [{ label: 'Sources', icon: 'sources' }, { label: 'Registry', icon: 'registry' }, { label: 'REST / MCP', icon: 'api' }] },
  'service-log-monitor': { stages: [{ label: 'Logs', icon: 'logs' }, { label: 'Threshold', icon: 'threshold' }, { label: 'Restart', icon: 'restart' }, { label: 'Metrics', icon: 'metrics' }] },
  'evm-rpc-postman': { stages: [{ label: 'Methods', icon: 'registry' }, { label: 'Request', icon: 'request' }, { label: 'RPC node', icon: 'node' }, { label: 'Response', icon: 'response' }] },
  'launchpad-charts': { stages: [{ label: 'Helm charts', icon: 'charts' }, { label: 'Kubernetes', icon: 'cluster' }, { label: 'Services', icon: 'service' }] },
  'terraform-cloud-foundation': { stages: [{ label: 'Terraform', icon: 'terraform' }, { label: 'Plan', icon: 'plan' }, { label: 'OCI', icon: 'cloud' }, { label: 'Cloudflare', icon: 'access' }], edges: [[0, 1], [1, 2], [1, 3]] },
  'johnaverse-fleet': { stages: [{ label: 'Git', icon: 'git' }, { label: 'Flux', icon: 'flux' }, { label: 'Terraform', icon: 'terraform' }, { label: 'Docker', icon: 'docker' }], edges: [[0, 1], [2, 3]] },
  'model-routing-and-access': { stages: [{ label: 'Tools', icon: 'tool' }, { label: 'Access', icon: 'access' }, { label: 'LiteLLM', icon: 'routing' }, { label: 'Models', icon: 'models' }] },
  'ops-ui-agent-guardrails': { stages: [{ label: 'Request', icon: 'request' }, { label: 'Guardrails', icon: 'shield' }, { label: 'Tool action', icon: 'tool' }] },
  'ai-development-and-qa': { stages: [{ label: 'Change', icon: 'code' }, { label: 'Review', icon: 'review' }, { label: 'QA', icon: 'qa' }, { label: 'Feedback', icon: 'feedback' }] },
  'ca-security-center': { stages: [{ label: 'Signals', icon: 'signal' }, { label: 'Triage', icon: 'triage' }, { label: 'Investigate', icon: 'review' }] },
  'code-and-contract-analysis': { stages: [{ label: 'Source', icon: 'code' }, { label: 'Analysis', icon: 'analysis' }, { label: 'Findings', icon: 'findings' }] },
  'blockchain-data-operations': { stages: [{ label: 'Nodes', icon: 'node' }, { label: 'RPC', icon: 'api' }, { label: 'Firehose', icon: 'stream' }, { label: 'Substreams', icon: 'sources' }], edges: [[0, 1], [0, 2], [2, 3]] },
  'nft-deployment-work': { stages: [{ label: 'Contract', icon: 'contract' }, { label: 'Deploy', icon: 'deploy' }, { label: 'Application', icon: 'service' }] },
  'resilience-and-update-policies': { stages: [{ label: 'Services', icon: 'node' }, { label: 'Backups', icon: 'backup' }, { label: 'Grafana', icon: 'metrics' }, { label: 'Updates', icon: 'update' }], edges: [[0, 1], [0, 2], [0, 3]] },
};

const { project, locale = 'en', title = project.data.title } = Astro.props;
const text = messages(locale);
const diagram = diagrams[project.id] ?? {
  stages: [{ label: 'Context', icon: 'sources' }, { label: 'Approach', icon: 'tool' }, { label: 'Outcome', icon: 'response' }],
} satisfies Diagram;
const centers = diagram.stages.length === 4 ? [70, 210, 350, 490] : [90, 280, 470];
const edges = diagram.edges ?? diagram.stages.slice(1).map((_, index) => [index, index + 1] as [number, number]);
const translatedLabels = localizedWorkflowStages(project.id,locale);
const stages = diagram.stages.map((stage,index) => ({ ...stage, label: translatedLabels?.[index] ?? stage.label }));
const routes = edges.map(([from, to]) => {
  const start = centers[from] + 43;
  const end = centers[to] - 43;
  const skip = to - from > 1;
  const height = from === 0 && to === 3 ? 17 : 34;
  return {
    start, end,
    path: skip ? `M${start} 102 C${start + 20} ${height} ${end - 20} ${height} ${end} 102` : `M${start} 102 H${end}`,
    arrow: skip ? `M${end - 7} 91 L${end} 102 L${end + 3} 89` : `M${end - 8} 98 L${end} 102 L${end - 8} 106`,
  };
});
const description = `${text.workflowDescription}: ${title}; ${stages.map(stage => stage.label).join(', ')}.`;
---
<div class="project-visual" data-ambient>
  <span class="project-visual-caption" aria-hidden="true">{text.workflowCaption}</span>
  <svg class="project-visual-svg" viewBox="0 0 560 210" width="560" height="210" role="img" aria-label={description} focusable="false" style="display:block;width:100%;height:auto;overflow:visible">
    <g aria-hidden="true">
      <rect x="1" y="1" width="558" height="208" rx="12" fill="currentColor" opacity=".025" />
      <path d="M20 25h30 M20 25v18 M540 25h-30 M540 25v18 M20 185h30 M20 185v-18 M540 185h-30 M540 185v-18" fill="none" stroke="currentColor" stroke-opacity=".18" stroke-width="1" />
      {Array.from({ length: 17 }, (_, column) => Array.from({ length: 5 }, (_, row) => (
        <circle cx={24 + column * 32} cy={41 + row * 32} r=".8" fill="currentColor" opacity=".11" />
      )))}
      <g fill="none" stroke="currentColor" stroke-opacity=".24" stroke-width="1.2">
        {routes.map(route => <path d={route.path} />)}
      </g>
      <g class="map-flow" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" opacity=".8">
        {routes.map(route => <path d={route.path} />)}
      </g>
      <g fill="none" stroke="var(--accent)" stroke-opacity=".65" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        {routes.map(route => <path d={route.arrow} />)}
      </g>
      {stages.map((stage, index) => (
        <g transform={`translate(${centers[index]}, 102)`}>
          <rect x="-43" y="-42" width="86" height="84" rx="15" fill="currentColor" fill-opacity=".045" stroke="currentColor" stroke-opacity=".16" />
          <path d="M-30-42h60" fill="none" stroke="var(--accent)" stroke-opacity=".55" stroke-width="1.4" />
          <rect x="-29" y="-29" width="58" height="58" rx="11" fill="var(--accent)" fill-opacity=".055" stroke="var(--accent)" stroke-opacity=".16" />
          <g transform="translate(-22, -22)" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            {icons[stage.icon].map(path => <path d={path} />)}
          </g>
          <circle cx="-43" cy="0" r="2.6" fill="var(--accent)" />
          <circle cx="43" cy="0" r="2.6" fill="var(--accent)" />
          <text class="project-visual-label" x="0" y="66" text-anchor="middle" fill="currentColor" font-family="var(--mono)" font-size="13" font-weight="500">{stage.label}</text>
        </g>
      ))}
    </g>
  </svg>
</div>
