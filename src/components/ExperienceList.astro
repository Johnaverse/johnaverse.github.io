---
import { experiences } from '../data/experience';
import type { DomainId } from '../data/domains';
import { localizedExperience } from '../i18n/experience';
import type { Locale } from '../i18n';
interface Props { domain: DomainId; locale?: Locale; }
const { domain, locale = 'en' } = Astro.props;
const relevant = experiences.filter(experience => experience.domains[domain]?.length);
---
<ol class="experience-list">
  {relevant.map(experience => { const detail = localizedExperience(experience,locale,domain); return <li class="experience-item" data-reveal><div class="experience-meta"><span class="experience-period">{detail.period}</span><span class="experience-employer">{experience.employer}</span></div><div class="experience-content"><h3>{detail.title}</h3><ul>{detail.domains[domain]?.map(point => <li>{point}</li>)}</ul></div></li>; })}
</ol>
