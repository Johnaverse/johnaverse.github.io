---
import Icon from './Icon.astro';
const hardware = [{ name: 'HP ZGX Nano G1n', kind: 'AI compute' }, { name: 'Mac Studio M4 Max', kind: 'Local workstation' }, { name: 'Synology DS1618+', kind: 'Storage & backup' }];
import { messages, localeRoot, type Locale } from '../i18n';
interface Props { teaser?: boolean; locale?: Locale; }
const { teaser = false, locale = 'en' } = Astro.props;
const text = messages(locale);
---
<section class="lab-section section container" id="lab">
  <div class="section-heading" data-reveal><div><p class="eyebrow">{text.localCloud}</p><h2>{text.labHeading}<br />{text.labAccent}</h2></div><p>{text.labIntro}</p></div>
  <figure class="lab-figure" data-reveal><img src="/images/hardware-lab.webp" alt={text.labCaption} width="1774" height="887" loading="lazy" decoding="async" /><figcaption>{text.labCaption}</figcaption></figure>
  <div class="hardware-list">{hardware.map((item, i) => <div><span class="eyebrow">0{i + 1} / {text.labTypes[i]}</span><h3>{item.name}</h3></div>)}</div>
  {teaser && <a class="text-link lab-link" href={`${localeRoot(locale)}cloud/#lab`}>{text.labLink} <Icon /></a>}
</section>
