---
import type { DomainId } from '../data/domains';
import { messages, type Locale } from '../i18n';
import { artworkDescriptions } from '../i18n/artwork';
interface Props { subject: DomainId | 'home'; variant?: 'hero' | 'card'; eager?: boolean; locale?: Locale; }
const { subject, variant = 'hero', eager = false, locale = 'en' } = Astro.props;
const descriptions = artworkDescriptions;
const base = subject === 'home' ? '/images/engineering-world' : `/images/domains/${subject}`;
const text = messages(locale);
---
<figure class={`artwork artwork-${variant} artwork-${subject}`} data-ambient>
  <div class="artwork-image">
    <img src={`${base}.webp`} srcset={`${base}-640.webp 640w, ${base}-1280.webp 1280w, ${base}.webp 1536w`} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1180px) calc((100vw - 100px) / 2), 600px" width="1536" height="1024" alt={variant === 'card' ? '' : descriptions[locale][subject]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
    <span class="art-glow" aria-hidden="true"></span>
    <span class="art-corner art-corner-top" aria-hidden="true"></span><span class="art-corner art-corner-bottom" aria-hidden="true"></span>
  </div>
  {variant === 'hero' && <figcaption><span>{subject === 'home' ? text.conceptHome.toUpperCase() : text.domainExplore.toUpperCase()+' / '+text.domains[subject].toUpperCase()}</span><span>{text.imageConcept}</span></figcaption>}
</figure>
