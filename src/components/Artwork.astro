---
import type { DomainId } from '../data/domains';
interface Props { subject: DomainId | 'home'; variant?: 'hero' | 'card'; eager?: boolean; }
const { subject, variant = 'hero', eager = false } = Astro.props;
const descriptions = {
  home: 'Conceptual engineering landscape connecting cloud servers, AI agents, blockchain ledgers, and security systems.',
  cloud: 'Conceptual cloud infrastructure with graphite servers, a glass cloud, and cyan storage and access connections.',
  ai: 'Conceptual violet model core connected to four agent modules through a control gate.',
  blockchain: 'Conceptual amber ledger blocks connected to graphite blockchain server nodes.',
  cybersecurity: 'Conceptual emerald protective shield and inspection lens beside service modules.',
};
const base = subject === 'home' ? '/images/engineering-world' : `/images/domains/${subject}`;
---
<figure class={`artwork artwork-${variant} artwork-${subject}`} data-ambient>
  <div class="artwork-image">
    <img src={`${base}.webp`} srcset={`${base}-640.webp 640w, ${base}-1280.webp 1280w, ${base}.webp 1536w`} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1180px) calc((100vw - 100px) / 2), 600px" width="1536" height="1024" alt={variant === 'card' ? '' : descriptions[subject]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
    <span class="art-glow" aria-hidden="true"></span>
    <span class="art-corner art-corner-top" aria-hidden="true"></span><span class="art-corner art-corner-bottom" aria-hidden="true"></span>
  </div>
  {variant === 'hero' && <figcaption><span>CONCEPT / {subject === 'home' ? 'CONNECTED ENGINEERING' : subject.toUpperCase()}</span><span>Editorial illustration</span></figcaption>}
</figure>
