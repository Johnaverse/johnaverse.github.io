---
interface Stage { title: string; subtitle: string; }
import { messages, type Locale } from '../i18n';
interface Props { stages?: Stage[]; label?: string; locale?: Locale; }
const { stages = [{ title: 'Cloud', subtitle: 'Provision & observe' }, { title: 'AI & automation', subtitle: 'Agents & workflows' }, { title: 'Blockchain', subtitle: 'Nodes & data services' }, { title: 'Cybersecurity', subtitle: 'Analyze & harden' }], label = 'Four disciplines. One engineering mindset.', locale = 'en' } = Astro.props;
const text = messages(locale);
const mapHeading = { en: 'SYSTEMS VIEW', 'zh-Hant': '系統檢視', 'zh-Hans': '系统视图', fr: 'VUE DU SYSTÈME' }[locale];
const coreLabel = { en: 'ENGINEERING', 'zh-Hant': '工程實踐', 'zh-Hans': '工程实践', fr: 'INGÉNIERIE' }[locale];
const positions = [{ x: 48, y: 88 }, { x: 450, y: 88 }, { x: 48, y: 337 }, { x: 450, y: 337 }];
---
<div class="system-map" data-ambient>
  <div class="map-topline"><span><span class="status-dot"></span> {mapHeading}</span><span>01 — 04</span></div>
  <svg class="map-svg" viewBox="0 0 700 480" role="img" aria-label={`${label} Connected engineering areas: ${stages.map(stage => `${stage.title}, ${stage.subtitle}`).join('; ')}. This is a conceptual diagram.`}>
    <defs><pattern id="map-grid" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".16" /></pattern></defs>
    <rect width="700" height="480" fill="url(#map-grid)" />
    <g class="map-routes" fill="none" stroke="currentColor" stroke-width="1"><path d="M250 136h36q20 0 20 20v64h18" /><path d="M450 136h-36q-20 0-20 20v64h-18" /><path d="M250 385h36q20 0 20-20v-105h18" /><path d="M450 385h-36q-20 0-20-20v-105h-18" /></g>
    <g class="map-flow" fill="none" stroke="currentColor" stroke-width="2"><path d="M250 136h36q20 0 20 20v64h18" /><path d="M450 136h-36q-20 0-20 20v64h-18" /><path d="M250 385h36q20 0 20-20v-105h18" /><path d="M450 385h-36q-20 0-20-20v-105h-18" /></g>
    <circle class="map-orbit" cx="350" cy="240" r="103" fill="none" stroke="currentColor" stroke-dasharray="2 12" opacity=".4" />
    <circle cx="350" cy="240" r="78" fill="none" stroke="currentColor" opacity=".17" />
    <circle class="map-core" cx="350" cy="240" r="56" />
    <text x="350" y="241" class="map-monogram" text-anchor="middle">jv.</text>
    <text x="350" y="266" class="map-core-label" text-anchor="middle">{coreLabel}</text>
    {stages.slice(0, 4).map((stage, i) => <g class="map-node" transform={`translate(${positions[i].x},${positions[i].y})`}><rect width="202" height="96" rx="10" /><rect class="map-node-icon" x="15" y="17" width="18" height="18" rx="4" /><path class="map-icon-line" d="M19 26h10M24 21v10" /><text class="map-node-index" x="186" y="26" text-anchor="end">0{i + 1}</text><text class="map-node-title" x="15" y="56">{stage.title}</text><text class="map-node-subtitle" x="15" y="76">{stage.subtitle}</text></g>)}
  </svg>
  <div class="map-bottomline"><span class="map-caption">{label}</span><span class="map-caption">{text.imageConcept.toUpperCase()}</span></div>
</div>
