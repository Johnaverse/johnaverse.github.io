---
import Icon from './Icon.astro';
import { domains } from '../data/domains';
---
<footer id="contact" class="site-footer">
  <div class="container">
    <div class="footer-top" data-reveal>
      <div><p class="eyebrow"><span class="status-dot"></span> GOOD SYSTEMS START WITH A CONVERSATION</p><h2>Let’s build something<br /><span class="text-muted">that holds up.</span></h2></div>
      <div class="contact-links"><a class="contact-email" href="mailto:contact@johnaverse.com">contact@johnaverse.com <Icon name="external" /></a><div class="contact-social"><a href="https://www.linkedin.com/in/johnathan-l-5b2492146/" target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" size={16} /></a><a href="https://github.com/Johnaverse" target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={16} /></a></div><p>Johnathan L. · Toronto, Canada</p></div>
    </div>
    <div class="footer-bottom"><a class="footer-brand" href="/">johnaverse.</a><div class="footer-domain-links">{domains.map(domain => <a href={`/${domain.id}/`}>{domain.shortName}</a>)}</div><button class="motion-toggle" type="button">Pause motion</button><span>© {new Date().getFullYear()} Johnathan L.</span></div>
  </div>
</footer>
