---
import Icon from './Icon.astro';
import { domains } from '../data/domains';
import { localeRoot, localizedPath, messages, type Locale } from '../i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const text = messages(locale);
---
<footer id="contact" class="site-footer">
  <div class="container">
    <div class="footer-top" data-reveal>
      <div><p class="eyebrow"><span class="status-dot"></span> <span data-footer-eyebrow>{text.homeFooter}</span></p><h2><span data-footer-heading>{text.footerHeading}</span><br /><span class="text-muted" data-footer-accent>{text.footerAccent}</span></h2></div>
      <div class="contact-links"><a class="contact-email" href="mailto:contact@johnaverse.cc">contact@johnaverse.cc <Icon name="external" /></a><div class="contact-social"><a href="https://www.linkedin.com/in/johnathan-l-5b2492146/" target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="external" size={16} /></a><a href="https://github.com/Johnaverse" target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={16} /></a></div><p data-footer-location>Johnathan L. · {text.toronto}</p></div>
    </div>
    <div class="footer-bottom"><a class="footer-brand" href={localeRoot(locale)}>johnaverse.</a><div class="footer-domain-links">{domains.map(domain => <a href={localizedPath(`/${domain.id}/`,locale)} data-footer-domain={domain.id}>{text.domains[domain.id]}</a>)}</div><button class="motion-toggle" type="button" data-pause-text={text.motionPause} data-resume-text={text.motionResume} data-reduced-text={text.motionReduced}>{text.motionPause}</button><span data-footer-copyright>{text.copyright.replace('{year}',String(new Date().getFullYear()))}</span></div>
  </div>
</footer>
